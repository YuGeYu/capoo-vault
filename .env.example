# Cloudflare Worker Secrets
# Set these with `wrangler secret put <NAME>` for production deployments.

SESSION_SECRET="replace-with-a-long-random-string"
IMPORT_TOKEN="replace-with-a-private-import-token"
AI_CHAT_API_KEY="replace-with-your-own-upstream-ai-key"
ALIPAY_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-alipay-app-private-key\n-----END PRIVATE KEY-----"
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-with-alipay-public-key\n-----END PUBLIC KEY-----"
